# Password visitors must enter on / to unlock /work
SITE_PASSWORD=change-me

# Random secret (32+ chars) used to sign the auth cookie.
# Generate one with: openssl rand -hex 32
AUTH_SECRET=change-me-to-a-long-random-string

# PostHog — client project token (safe in browser). US Cloud host below.
PUBLIC_POSTHOG_KEY=phc_your_project_token
PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
