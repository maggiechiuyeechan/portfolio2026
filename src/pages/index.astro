---
/**
 * Public password hero (Figma "larger than 16'" 247:118290 and the smaller
 * desktop / tablet / mobile variants). Prerendered for speed.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import Text from "../components/ui/Text.astro";
import FooterLinks from "../components/ui/FooterLinks.astro";
import PasswordForm from "../components/auth/PasswordForm";
import { site } from "../config/site";

export const prerender = true;
---

<BaseLayout>
  <div class="hero">
    <div class="hero-content">
      <img
        class="hero-avatar"
        src="/images/avatar.png"
        alt={`Portrait of ${site.name}`}
        width="200"
        height="250"
      />
      <div class="hero-text">
        <Text as="h1" variant="display" class="hero-name">{site.name}</Text>
        <Text as="p" variant="title" class="hero-title">
          {site.title}<br />{site.tagline}
        </Text>
        <Text as="p" variant="body" class="hero-bio">{site.bio}</Text>
      </div>
      <PasswordForm client:load />
    </div>
    <footer class="hero-footer">
      <FooterLinks />
    </footer>
  </div>
</BaseLayout>

<style>
  .hero {
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: var(--spacing-5) 1.5rem;
  }

  .hero-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--spacing-5);
    text-align: center;
  }

  .hero-avatar {
    /* Figma: 200x250, radius 72 */
    width: 12.5rem;
    height: 15.625rem;
    border-radius: 4.5rem;
    object-fit: cover;
  }

  .hero-text {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--spacing-2);
    margin-bottom: var(--spacing-3);
  }

  .hero-bio {
    max-width: 35.5625rem; /* 569px per Figma */
  }

  .hero-footer {
    position: fixed;
    inset-inline: 0;
    bottom: var(--spacing-5);
    display: flex;
    justify-content: center;
    padding-inline: 1rem;
  }

  /* Smaller desktop (Figma 1024 frame): avatar 180x225 */
  @media (max-width: 80rem) {
    .hero-avatar {
      width: 11.25rem;
      height: 14.0625rem;
    }
  }

  /* Tablet (Figma 768 frame): avatar 160x200 */
  @media (max-width: 52rem) {
    .hero-avatar {
      width: 10rem;
      height: 12.5rem;
    }
  }

  /* Mobile (Figma 390 frame): avatar 140x175, footer static */
  @media (max-width: 41.25rem) {
    .hero-avatar {
      width: 8.75rem;
      height: 10.9375rem;
    }
  }
</style>
