---
/**
 * Public password hero.
 *
 * Prerendered and CDN-cached. The hero variant is chosen client-side at module
 * scope (see HeroRotator), so this page has no variant knowledge and stays
 * static — randomising server-side would mean going SSR and trading a ~20ms
 * cached edge response for a function invocation on every load.
 *
 * Layout styles live in src/styles/hero.css, shared with /versions/[id].
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import HeroRotator from "../components/hero/HeroRotator";
import { site } from "../config/site";

export const prerender = true;
---

<BaseLayout>
  <div class="hero">
    <div class="hero-inner">
      <HeroRotator
        client:load
        name={site.name}
        title={site.title}
        tagline={site.tagline}
      />
    </div>
  </div>
</BaseLayout>
