---
/**
 * Public password hero (Figma "larger than 16'" 247:118290 and the smaller
 * desktop / tablet / mobile variants). Prerendered for speed.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import FooterLinks from "../components/ui/FooterLinks.astro";
import HeroEntrance from "../components/auth/HeroEntrance";
import { site } from "../config/site";

export const prerender = true;
---

<BaseLayout>
  <div class="hero">
    <div class="hero-inner">
      <HeroEntrance
        client:load
        name={site.name}
        title={site.title}
        tagline={site.tagline}
        bio={site.bio}
      avatarSrc="/images/butterfly_slowmo.gif"
      avatarAlt="White butterflies in motion"
      />
    </div>
    <footer class="hero-footer">
      <FooterLinks />
    </footer>
  </div>
</BaseLayout>

<style>
  .hero {
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: var(--spacing-5) 1.5rem;
  }

  .hero-inner {
    width: 100%;
    display: flex;
    justify-content: center;
  }

  .hero-footer {
    position: fixed;
    inset-inline: 0;
    bottom: var(--spacing-5);
    display: flex;
    justify-content: center;
    padding-inline: 1rem;
  }

  /* Short viewports: footer scrolls with content instead of pinning to bottom */
  @media (max-height: 40rem) {
    .hero {
      min-height: auto;
      justify-content: flex-start;
      padding-block: var(--spacing-5);
    }

    .hero-footer {
      position: static;
      margin-top: var(--spacing-5);
      width: 100%;
    }
  }

  /* Avatar frame — dimensions live in CSS so breakpoints apply */
  .hero-inner :global(.hero-avatar-frame) {
    width: 9rem;
    height: 11.25rem;
  }

  .hero-inner :global(.hero-avatar-entrance) {
    margin-bottom: 1rem;
  }

  @media (max-width: 80rem) {
    .hero-inner :global(.hero-avatar-frame) {
      width: 8.1rem;
      height: 10.125rem;
    }
  }

  @media (max-width: 52rem) {
    .hero-inner :global(.hero-avatar-frame) {
      width: 7.2rem;
      height: 9rem;
    }
  }

  /* Password chip — base padding; taller tap target on mobile */
  .hero-inner :global(.password-chip) {
    padding: var(--spacing-1) var(--spacing-2);
  }

  @media (max-width: 41.25rem) {
    .hero-inner :global(.hero-avatar-frame) {
      width: 8.3rem; /* +2rem from desktop-scaled mobile size */
      height: 9.875rem;
    }

    .hero-inner :global(.password-chip) {
      padding-block: calc(var(--spacing-1) + 0.5rem);
    }
  }
</style>
