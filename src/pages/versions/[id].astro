---
/**
 * Deep link to a specific hero variant — replaces the eight compare-* pages,
 * which differed from each other by three lines.
 *
 * Forcing a variant here does NOT consume a rotation slot, so you can review
 * or screenshot any version without shortening your own cycle on /.
 *
 * noindex: these are design explorations, not pages a recruiter should land on
 * from search.
 */
import BaseLayout from "../../layouts/BaseLayout.astro";
import HeroRotator from "../../components/hero/HeroRotator";
import { HERO_VARIANTS } from "../../config/heroVariants";
import { site } from "../../config/site";

export const prerender = true;

export function getStaticPaths() {
  return HERO_VARIANTS.map((variant) => ({
    params: { id: variant.id },
    props: { variant },
  }));
}

const { variant } = Astro.props;
---

<BaseLayout title={`${variant.label} — ${site.name}`} noindex>
  <div class="hero">
    <div class="hero-inner">
      <HeroRotator
        client:load
        name={site.name}
        title={site.title}
        tagline={site.tagline}
        variantId={variant.id}
      />
    </div>
  </div>
</BaseLayout>
