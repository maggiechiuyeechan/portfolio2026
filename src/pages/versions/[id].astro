---
/**
 * Deep link to a specific hero variant — replaces the eight compare-* pages,
 * which differed from each other by three lines.
 *
 * Forcing a variant here does NOT consume a rotation slot, so you can review
 * or screenshot any version without shortening your own cycle on /.
 *
 * noindex: these are design explorations, not pages a recruiter should land on
 * from search.
 */
import BaseLayout from "../../layouts/BaseLayout.astro";
import HeroRotator from "../../components/hero/HeroRotator";
import { HERO_VARIANTS } from "../../config/heroVariants";
import { site } from "../../config/site";

export const prerender = true;

export function getStaticPaths() {
  return HERO_VARIANTS.map((variant) => ({
    params: { id: variant.id },
    props: { variant },
  }));
}

const { variant } = Astro.props;
---

<BaseLayout title={`${variant.label} — ${site.name}`} noindex>
  <div class="hero">
    <div class="hero-inner">
      <HeroRotator
        client:load
        name={site.name}
        title={site.title}
        tagline={site.tagline}
        variantId={variant.id}
      />
    </div>
  </div>

  {
    import.meta.env.DEV && (
      <nav class="version-switch" aria-label="Hero versions">
        {HERO_VARIANTS.map((v) => (
          <a
            href={`/versions/${v.id}`}
            class:list={["version-switch-link", { current: v.id === variant.id }]}
            aria-current={v.id === variant.id ? "page" : undefined}
          >
            {v.label}
          </a>
        ))}
      </nav>
    )
  }
</BaseLayout>

<style>
  /* Dev-only switcher. Never ships to production. */
  .version-switch {
    position: fixed;
    top: var(--spacing-2);
    left: 50%;
    z-index: 20;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1px;
    padding: 2px;
    border-radius: 999px;
    background: var(--color-background-onmain-default);
    border: 1px solid var(--color-border-default);
    transform: translateX(-50%);
  }

  .version-switch-link {
    padding: 0.25rem 0.75rem;
    border-radius: 999px;
    font-family: Inter, sans-serif;
    font-size: 0.75rem;
    line-height: 1.5;
    letter-spacing: -0.01em;
    color: var(--color-typography-content-secondary);
    text-decoration: none;
  }

  .version-switch-link.current {
    background: var(--color-background-main);
    color: var(--color-typography-content-default);
  }
</style>
