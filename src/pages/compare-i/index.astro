---
/**
 * Version I — 28px grid with sprinkled multiply dots (Figma node 354:82 palette).
 * Click the background to reshuffle the dots.
 */
import BaseLayout from "../../layouts/BaseLayout.astro";
import HeroEntrance from "../../components/auth/HeroEntrance";
import { site } from "../../config/site";

export const prerender = true;

const compareLinks = [
  { label: "Version B", href: "/compare" },
  { label: "Version C", href: "/compare-c" },
  { label: "Version F", href: "/compare-f" },
  { label: "Version I", href: "/compare-i", current: true },
  { label: "Version J", href: "/compare-j" },
  { label: "Version L", href: "/compare-l" },
  { label: "Version M", href: "/compare-m", desktopOnly: true },
  { label: "Version N", href: "/compare-n" },
  { label: "Version O", href: "/" },
];
---

<BaseLayout>
  <nav class="compare-switch" aria-label="Compare hero versions">
    {
      compareLinks.map(({ label, href, current, desktopOnly }) => (
        <a href={href} class:list={["compare-switch-link", { current, "desktop-only": desktopOnly }]} aria-current={current ? "page" : undefined}>
          {label}
        </a>
      ))
    }
  </nav>

  <div class="hero">
    <div class="hero-inner">
      <HeroEntrance
        client:load
        name={site.name}
        title={site.title}
        tagline={site.tagline}
        showAvatar={false}
        physicsFullCanvas={true}
        physicsVariant="grid-sprinkle-i"
      />
    </div>
  </div>
</BaseLayout>

<style>
  .compare-switch {
    position: fixed;
    top: var(--spacing-2);
    left: 50%;
    z-index: 20;
    display: flex;
    gap: 1px;
    padding: 2px;
    border-radius: 999px;
    background: var(--color-background-onmain-default);
    border: 1px solid var(--color-border-default);
    transform: translateX(-50%);
  }

  .compare-switch-link {
    padding: 0.25rem 0.75rem;
    border-radius: 999px;
    font-family: Inter, sans-serif;
    font-size: 0.75rem;
    line-height: 1.5;
    letter-spacing: -0.01em;
    color: var(--color-typography-content-secondary);
    text-decoration: none;
  }

  .compare-switch-link.current {
    background: var(--color-background-main);
    color: var(--color-typography-content-default);
  }

  .hero {
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: var(--spacing-5) 1.5rem;
  }

  .hero-inner {
    width: fit-content;
    max-width: 100%;
    display: flex;
    justify-content: center;
    position: relative;
    /* Tall viewports: sit slightly below true center */
    transform: translateY(2rem);
    z-index: 10;
  }

  @media (max-height: 40.625rem) {
    .hero {
      min-height: 100dvh;
      justify-content: flex-end;
      padding-top: var(--spacing-5);
      padding-bottom: 4rem; /* 64px */
    }

    .hero-inner {
      transform: none;
    }
  }

  @media (max-width: 48rem) {
    .compare-switch-link.desktop-only {
      display: none;
    }
  }
</style>
