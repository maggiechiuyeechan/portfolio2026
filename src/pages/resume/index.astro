---
/**
 * Public online resume. Prerendered and intentionally outside the password
 * gate (not in PROTECTED_PREFIXES). Layout mirrors the Figma "resume" file
 * (tVMS249ETBK3cSjxrHQvGB, node 1:2) on the shared 8-col content grid.
 * Copy lives in src/config/resume.ts; styles in src/styles/resume.css.
 */
import BaseLayout from "../../layouts/BaseLayout.astro";
import Container from "../../components/layout/Container.astro";
import ResumeRole from "../../components/resume/ResumeRole.astro";
import ResumeSkills from "../../components/resume/ResumeSkills.astro";
import ResumeDebugPanel from "../../components/resume/ResumeDebugPanel";
import { resume } from "../../config/resume";
import { site } from "../../config/site";

export const prerender = true;

const title = `Resume — ${site.fullName}`;
const description = `${resume.name} — resume`;
---

<BaseLayout title={title} description={description}>
  <div class="resume">
    <Container>
      <div class="resume-content">
        <div class="resume-debug-overlay" aria-hidden="true">
          {Array.from({ length: 8 }).map(() => <div class="resume-debug-col" />)}
        </div>
        <div class="resume-row">
          <header class="resume-rail">
            <h1 class="resume-name text-title">{resume.name}</h1>
            <div class="resume-contacts-block">
              <h2 class="resume-section-label text-caption">Contact</h2>
              <div class="resume-contacts">
                {
                  resume.contactColumns.map((group) => (
                    <div class="resume-contact-group text-body">
                      {group.map((contact) =>
                        contact.href ? (
                          <a href={contact.href}>{contact.label}</a>
                        ) : (
                          <p>{contact.label}</p>
                        ),
                      )}
                    </div>
                  ))
                }
              </div>
            </div>
            <div class="resume-education-block">
              <h2 class="resume-section-label text-caption">Education</h2>
              <div class="resume-education">
                {
                  resume.education.map((entry) => (
                    <p class="resume-education-line text-body">
                      <span class="resume-education-degree">{entry.degree}</span>
                      <span class="resume-education-school">
                        {entry.school}, {entry.year}
                      </span>
                      {entry.location && (
                        <span class="resume-education-location">
                          {entry.location}
                        </span>
                      )}
                    </p>
                  ))
                }
              </div>
            </div>
            <a
              class="resume-printable-link text-body"
              href="/Maggie-CY-Chan-Resume.pdf"
              download
              aria-label="Download printable resume PDF"
            >
              <span>Printable version</span>
              <svg
                class="resume-printable-link-icon lucide lucide-download"
                xmlns="http://www.w3.org/2000/svg"
                width="14"
                height="14"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M12 15V3"></path>
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                <path d="m7 10 5 5 5-5"></path>
              </svg>
            </a>
          </header>

          <section class="resume-col-body">
            <h2 class="resume-section-label text-caption">Experience</h2>
            {resume.work.map((role) => <ResumeRole role={role} />)}
            <h2 class="resume-section-label resume-section-label--skills text-caption">
              Skills
            </h2>
            <ResumeSkills groups={resume.skills} />
          </section>
        </div>
      </div>
    </Container>
    <ResumeDebugPanel client:idle />
  </div>
</BaseLayout>
