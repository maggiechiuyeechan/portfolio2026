---
/**
 * Public online resume. Prerendered and intentionally outside the password
 * gate (not in PROTECTED_PREFIXES). Layout mirrors the Figma "resume" file
 * (tVMS249ETBK3cSjxrHQvGB, node 1:2) on the shared 8-col content grid.
 * Copy lives in src/config/resume.ts; styles in src/styles/resume.css.
 */
import BaseLayout from "../../layouts/BaseLayout.astro";
import Container from "../../components/layout/Container.astro";
import ResumeRole from "../../components/resume/ResumeRole.astro";
import { resume } from "../../config/resume";
import { site } from "../../config/site";

export const prerender = true;

const title = `Resume — ${site.fullName}`;
const description = `${resume.name} — resume`;
---

<BaseLayout title={title} description={description}>
  <div class="resume">
    <Container>
      <div class="resume-content">
        <div class="resume-debug-overlay" aria-hidden="true">
          {Array.from({ length: 8 }).map(() => <div class="resume-debug-col" />)}
        </div>
        <div class="resume-row">
          <header class="resume-rail">
            <h1 class="resume-name text-title">{resume.name}</h1>
            <div class="resume-contacts">
              {
                resume.contactColumns.map((group) => (
                  <div class="resume-contact-group text-body">
                    {group.map((contact) =>
                      contact.href ? (
                        <a href={contact.href}>{contact.label}</a>
                      ) : (
                        <p>{contact.label}</p>
                      ),
                    )}
                  </div>
                ))
              }
            </div>
            <div class="resume-education">
              {
                resume.education.map((entry) => (
                  <p class="resume-education-line text-body">
                    <span class="resume-education-degree">{entry.degree}</span>
                    <span class="resume-education-school">{entry.school}</span>
                    {
                      entry.location && (
                        <span class="resume-education-location">
                          {entry.location}
                        </span>
                      )
                    }
                  </p>
                ))
              }
            </div>
          </header>

          <section class="resume-col-body">
            {resume.work.map((role) => <ResumeRole role={role} />)}
          </section>
        </div>
      </div>
    </Container>
  </div>
</BaseLayout>
