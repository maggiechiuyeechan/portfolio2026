---
/**
 * Protected single-page case study feed (Figma V2 work page).
 * SSR so the middleware cookie gate runs on every request.
 */
import { getCollection } from "astro:content";
import ContentShell from "../../layouts/ContentShell.astro";
import Container from "../../components/layout/Container.astro";
import Section from "../../components/layout/Section.astro";
import Text from "../../components/ui/Text.astro";
import StudyBlock from "../../components/work/StudyBlock.astro";
import FadeInView from "../../components/work/FadeInView";
import { site } from "../../config/site";

export const prerender = false;

// Spread before sorting: sort mutates, and getCollection() may hand back a
// shared cached array that other routes read.
const studies = [...(await getCollection("work"))].sort(
  (a, b) => a.data.order - b.data.order,
);

const workLinks = studies.map((study) => ({
  label: study.data.navLabel,
  href: `#${study.data.anchorId}`,
}));
---

<ContentShell title={`Work — ${site.name}`} workLinks={workLinks} logoRevealsOnScroll>
  <Container>
    {/*
      Reuses the study text grid so the lede lines up with the case study copy,
      and the same reveal so it enters with the first study.
    */}
    <Section class="work-intro">
      <FadeInView client:load eager>
        <div class="study-text" data-nav-logo-reveal>
          <div class="study-text-inner">
            <Text as="p" variant="title" class="hero-title">
              <Fragment set:html={site.workIntroHtml} />
            </Text>
          </div>
        </div>
      </FadeInView>
    </Section>
    {
      studies.map((study, index) => (
        <StudyBlock
          anchorId={study.data.anchorId}
          title={study.data.title}
          meta={study.data.meta}
          subtitle={study.data.subtitle}
          images={study.data.images}
          eager={index === 0}
        />
      ))
    }
  </Container>
</ContentShell>
