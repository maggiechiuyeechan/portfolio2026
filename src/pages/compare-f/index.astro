---
/**
 * Version F — draggable paper desk (Version D shapes, multiply blend).
 */
import BaseLayout from "../../layouts/BaseLayout.astro";
import FooterLinks from "../../components/ui/FooterLinks.astro";
import HeroEntrance from "../../components/auth/HeroEntrance";
import { site } from "../../config/site";

export const prerender = true;

const compareLinks = [
  { label: "Version A", href: "/" },
  { label: "Version B", href: "/compare" },
  { label: "Version C", href: "/compare-c" },
  { label: "Version D", href: "/compare-d" },
  { label: "Version E", href: "/compare-e" },
  { label: "Version F", href: "/compare-f", current: true },
  { label: "Version G", href: "/compare-g" },
  { label: "Version H", href: "/compare-h" },
];
---

<BaseLayout>
  <nav class="compare-switch" aria-label="Compare hero versions">
    {
      compareLinks.map(({ label, href, current }) => (
        <a href={href} class:list={["compare-switch-link", { current }]} aria-current={current ? "page" : undefined}>
          {label}
        </a>
      ))
    }
  </nav>

  <div class="hero">
    <div class="hero-inner">
      <HeroEntrance
        client:load
        name={site.name}
        title={site.title}
        tagline={site.tagline}
        bio={site.bio}
        showAvatar={false}
        physicsFullCanvas={true}
        physicsVariant="shapes-d-desk"
      />
    </div>
    <footer class="hero-footer">
      <FooterLinks />
    </footer>
  </div>
</BaseLayout>

<style>
  .compare-switch {
    position: fixed;
    top: var(--spacing-2);
    left: 50%;
    z-index: 20;
    display: flex;
    gap: 1px;
    padding: 2px;
    border-radius: 999px;
    background: var(--color-background-onmain-default);
    border: 1px solid var(--color-border-default);
    transform: translateX(-50%);
  }

  .compare-switch-link {
    padding: 0.25rem 0.75rem;
    border-radius: 999px;
    font-family: Inter, sans-serif;
    font-size: 0.75rem;
    line-height: 1.5;
    letter-spacing: -0.01em;
    color: var(--color-typography-content-secondary);
    text-decoration: none;
  }

  .compare-switch-link.current {
    background: var(--color-background-main);
    color: var(--color-typography-content-default);
  }

  .hero {
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: var(--spacing-5) 1.5rem;
  }

  .hero-inner {
    width: 100%;
    display: flex;
    justify-content: center;
    position: relative;
  }

  .hero-footer {
    position: fixed;
    inset-inline: 0;
    bottom: var(--spacing-5);
    display: flex;
    justify-content: center;
    padding-inline: 1rem;
  }

  @media (max-height: 40rem) {
    .hero {
      min-height: auto;
      justify-content: flex-start;
      padding-block: var(--spacing-5);
    }

    .hero-footer {
      position: static;
      margin-top: var(--spacing-5);
      width: 100%;
    }
  }
</style>
