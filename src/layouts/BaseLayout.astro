---
import "../styles/global.css";
import PostHog from "../components/posthog.astro";
import { site, siteProfileLinks } from "../config/site";

interface Props {
  title?: string;
  description?: string;
  /** Keep this page out of search results (hero explorations, gated content). */
  noindex?: boolean;
  /** Override canonical path (defaults to current pathname). */
  canonicalPath?: string;
  /**
   * Preload the display face used by the hero h1. Only the hero routes render
   * an h1 in that face — /work leads with h2s — so preloading it everywhere
   * cost ~130KB of high-priority bandwidth on a page that never uses it.
   */
  preloadDisplayFont?: boolean;
}

const {
  title = site.seoTitle,
  description = site.seoDescription,
  noindex = false,
  canonicalPath,
  preloadDisplayFont = false,
} = Astro.props;

const canonical = new URL(canonicalPath ?? Astro.url.pathname, site.url).href;
const ogImage = new URL(site.ogImage, site.url).href;

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: site.fullName,
  alternateName: site.name,
  jobTitle: "VP of Design & Research",
  worksFor: {
    "@type": "Organization",
    name: "ClickUp",
  },
  url: `${site.url}/`,
  description: site.seoDescription,
  sameAs: siteProfileLinks,
};

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: site.seoTitle,
  url: `${site.url}/`,
  description: site.seoDescription,
  author: {
    "@type": "Person",
    name: site.fullName,
  },
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="author" content={site.fullName} />
    {noindex ? (
      <meta name="robots" content="noindex, nofollow" />
    ) : (
      <meta name="robots" content="index, follow" />
    )}
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.fullName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
    {!noindex && (
      <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
    )}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {/* Body face — used on every route, so always worth preloading. */}
    <link
      rel="preload"
      href="/fonts/geist/Geist-Variable.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/geist/GeistMono-Variable.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    {
      preloadDisplayFont && (
        <>
          <link
            rel="preload"
            href="/fonts/aguzzo/AguzzoVF-TRIAL.woff2"
            as="font"
            type="font/woff2"
            crossorigin
          />
          <link
            rel="preload"
            href="/fonts/bagoss/Bagoss-w320s0w60.woff2"
            as="font"
            type="font/woff2"
            crossorigin
          />
        </>
      )
    }
    <title>{title}</title>
    <PostHog />
  </head>
  <body>
    <slot />
    <script>
      import { initCuelume } from "../lib/cuelume";
      import { initCursorLabel } from "../scripts/cursor-label";
      initCuelume();
      initCursorLabel();
    </script>
  </body>
</html>
