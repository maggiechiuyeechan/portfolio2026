---
import "../styles/global.css";
import { site, siteProfileLinks } from "../config/site";

interface Props {
  title?: string;
  description?: string;
  /** Keep this page out of search results (hero explorations, gated content). */
  noindex?: boolean;
  /** Override canonical path (defaults to current pathname). */
  canonicalPath?: string;
}

const {
  title = site.seoTitle,
  description = site.seoDescription,
  noindex = false,
  canonicalPath,
} = Astro.props;

const canonical = new URL(canonicalPath ?? Astro.url.pathname, site.url).href;
const ogImage = new URL(site.ogImage, site.url).href;

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: site.fullName,
  alternateName: site.name,
  jobTitle: "VP of Design & Research",
  worksFor: {
    "@type": "Organization",
    name: "ClickUp",
  },
  url: `${site.url}/`,
  description: site.seoDescription,
  sameAs: siteProfileLinks,
};

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: site.seoTitle,
  url: `${site.url}/`,
  description: site.seoDescription,
  author: {
    "@type": "Person",
    name: site.fullName,
  },
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="author" content={site.fullName} />
    {noindex ? (
      <meta name="robots" content="noindex, nofollow" />
    ) : (
      <meta name="robots" content="index, follow" />
    )}
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.fullName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
    {!noindex && (
      <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
    )}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500&family=Atkinson+Hyperlegible+Mono&display=swap"
      rel="stylesheet"
    />
    <link
      rel="preload"
      href="/fonts/bagoss/Bagoss-w320s0w60.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <title>{title}</title>
  </head>
  <body>
    <slot />
    <script>
      import { initCuelume } from "../lib/cuelume";
      initCuelume();
    </script>
  </body>
</html>
