---
import "../styles/global.css";
import { site } from "../config/site";

interface Props {
  title?: string;
  description?: string;
  /** Keep this page out of search results (hero explorations, gated content). */
  noindex?: boolean;
}

const {
  title = `${site.name} — ${site.title}`,
  description = site.tagline,
  noindex = false,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500&family=Atkinson+Hyperlegible+Mono&display=swap"
      rel="stylesheet"
    />
    <link
      rel="preload"
      href="/fonts/bagoss/Bagoss-w320s0w60.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
