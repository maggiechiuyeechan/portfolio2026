---
/**
 * One case study section (Figma "SingleStudyContainer"):
 * StudyText (8-col grid, text spanning columns 1-4) + stacked images
 * separated by the 12px grid gutter.
 */
import type { ImageMetadata } from "astro";
import Text from "../ui/Text.astro";
import Section from "../layout/Section.astro";
import StudyImage from "./StudyImage.astro";

interface Props {
  anchorId: string;
  title: string;
  meta?: string;
  subtitle: string;
  images: { src: ImageMetadata; alt: string }[];
  eager?: boolean;
}

const { anchorId, title, meta, subtitle, images, eager = false } = Astro.props;
---

<Section id={anchorId} class="study">
  <div class="study-text">
    <div class="study-text-inner">
      <Text as="h2" variant="heading">
        {title}
        {meta && <span class="study-meta">{meta}</span>}
      </Text>
      <Text as="p" variant="body">{subtitle}</Text>
    </div>
  </div>
  <div class="study-images">
    {
      images.map((image, index) => (
        <StudyImage
          src={image.src}
          alt={image.alt}
          loading={eager && index === 0 ? "eager" : "lazy"}
        />
      ))
    }
  </div>
</Section>

<style>
  .study-text {
    display: grid;
    grid-template-columns: repeat(var(--grid-columns), minmax(0, 1fr));
    gap: var(--grid-gutter);
  }

  .study-text-inner {
    grid-column: 1 / span 4;
    display: flex;
    flex-direction: column;
    gap: var(--spacing-05);
  }

  .study-meta {
    color: var(--color-typography-content-tertiary);
  }

  .study-images {
    margin-top: var(--grid-gutter);
    display: flex;
    flex-direction: column;
    gap: var(--grid-gutter);
  }

  @media (max-width: 41.25rem) {
    .study-text {
      grid-template-columns: minmax(0, 1fr);
    }
    .study-text-inner {
      grid-column: auto;
    }
  }
</style>
