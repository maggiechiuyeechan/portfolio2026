---
/**
 * Case study mockup image. Uses Astro's image pipeline (WebP variants,
 * lazy loading). Exports from Figma are faithful frames, so no extra
 * borders or radii are applied here.
 */
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  src: ImageMetadata;
  alt: string;
  loading?: "lazy" | "eager";
}

const { src, alt, loading = "lazy" } = Astro.props;
---

<Image
  src={src}
  alt={alt}
  widths={[720, 1200, 1880]}
  sizes="(max-width: 41.25rem) 100vw, (max-width: 80rem) 78vw, 62.5rem"
  loading={loading}
  class="study-image"
/>
