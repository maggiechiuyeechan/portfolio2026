---
/**
 * Hero footer (Figma 247:118301): "Linkedin · X · Want a password? Get in touch"
 * Inter 14, content-secondary, centered.
 */
import { site } from "../../config/site";

const [linkedin, x, contact] = site.socials;
---

<p class="footer-links">
  <a href={linkedin.href} target="_blank" rel="noreferrer">{linkedin.label}</a>
  <span aria-hidden="true">·</span>
  <a href={x.href} target="_blank" rel="noreferrer">{x.label}</a>
  <span aria-hidden="true">·</span>
  <span>Want a password?</span>
  <a href={contact.href}>Get in touch</a>
</p>

<style>
  .footer-links {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.375rem;
    font-family: "Inter", sans-serif;
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--color-typography-content-secondary);
    text-align: center;
  }

  .footer-links a {
    color: inherit;
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .footer-links a:hover {
    color: var(--color-typography-content-default);
  }
</style>
