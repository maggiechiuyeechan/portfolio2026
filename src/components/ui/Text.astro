---
/**
 * Typography primitive. `variant` maps 1:1 to the Figma typescale
 * (classes defined in src/styles/typography.css).
 */
type Variant = "display" | "title" | "heading" | "body" | "caption";

interface Props {
  as?: string;
  variant: Variant;
  class?: string;
  id?: string;
}

const { as: Tag = "p", variant, class: className, id } = Astro.props;
---

<Tag class:list={[`text-${variant}`, className]} id={id}><slot /></Tag>
