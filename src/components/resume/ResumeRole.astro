---
import Text from "../ui/Text.astro";
import ResumeRoleHeader from "./ResumeRoleHeader.astro";
import ResumeBullets from "./ResumeBullets.astro";
import ResumeHighlightGroup from "./ResumeHighlightGroup.astro";
import type { ResumeRole } from "../../config/resume";

interface Props {
  role: ResumeRole;
  hideHeader?: boolean;
}

const { role, hideHeader = false } = Astro.props;
---

<article class="resume-role">
  {
    !hideHeader && (
      <ResumeRoleHeader
        company={role.company}
        title={role.title}
        dates={role.dates}
        promotion={role.promotion}
        meta={role.meta}
      />
    )
  }
  {
    hideHeader && role.meta && role.meta.length > 0 && (
      <div class="resume-role-meta text-body">
        {role.meta.map((line) => (
          <p>{line}</p>
        ))}
      </div>
    )
  }
  {
    role.summary && (
      <Text as="p" variant="body" class="resume-role-summary">
        {role.summary}
      </Text>
    )
  }
  {role.bullets && <ResumeBullets bullets={role.bullets} />}
  {
    role.groups?.map((group) => (
      <ResumeHighlightGroup heading={group.heading} bullets={group.bullets} />
    ))
  }
</article>
